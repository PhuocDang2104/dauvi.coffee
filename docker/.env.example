# Đổi mật khẩu trước khi chạy production. Không commit file docker/.env.
POSTGRES_DB=dauvi
POSTGRES_USER=dauvi
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Backend chỉ bind loopback để Caddy trên cùng máy reverse proxy vào.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000

# Domain frontend Vercel và domain API thật, phân cách bằng dấu phẩy nếu có nhiều giá trị.
CORS_ORIGINS=https://dauvi-coffee.vercel.app
ALLOWED_HOSTS=api.example.duckdns.org,localhost,127.0.0.1

DOCS_ENABLED=false
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
FORWARDED_ALLOW_IPS=*

